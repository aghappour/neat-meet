# ─── Core ────────────────────────────────────────────────────────────────
# Anthropic API key — powers the rolling summary and grounded insights.
ANTHROPIC_API_KEY=

# Model used for summary + insights. sonnet-5 balances quality and latency;
# bump to claude-opus-5 if insight quality matters more than speed.
CLAUDE_MODEL=claude-sonnet-5

# ─── Transcription ───────────────────────────────────────────────────────
# Which transcription provider to use: "whisper" (local, default) or "deepgram".
TRANSCRIPTION_PROVIDER=whisper

# Local Whisper profile: "capable" (distil-large-v3, ~1s chunks, near-real-time)
# or "modest" (base/small, longer chunks, a few seconds of lag). Both are free
# and fully local. Also selectable at runtime from the UI.
WHISPER_PROFILE=capable

# Port the Python faster-whisper sidecar listens on (local WebSocket).
WHISPER_SIDECAR_PORT=8765

# Optional: only needed if TRANSCRIPTION_PROVIDER=deepgram.
DEEPGRAM_API_KEY=

# ─── Connections (MCP connectors for grounded insights) ──────────────────
# Each service is optional: leave a pair blank and that connector is skipped
# gracefully (the app still runs with whatever subset you configure).
# These are the *hosted MCP endpoint* URL + auth token for each service.
NOTION_MCP_URL=
NOTION_MCP_TOKEN=

SLACK_MCP_URL=
SLACK_MCP_TOKEN=

GDRIVE_MCP_URL=
GDRIVE_MCP_TOKEN=

# Zapier is the fan-out for Gmail + Telegram (and 9000+ other apps).
# Enable the specific Zapier actions (Gmail send, Telegram send, etc.) in Zapier.
ZAPIER_MCP_URL=
ZAPIER_MCP_TOKEN=

# ─── Server ──────────────────────────────────────────────────────────────
PORT=3000
