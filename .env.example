# ─── Core ────────────────────────────────────────────────────────────────
# Anthropic credentials — power the rolling summary and grounded insights.
# Option 1: paste an API key here.
# Option 2 (no raw key to manage): run `ant auth login` (the Anthropic CLI), then
#   start the app with `npm run dev:auth` instead of `npm run dev`. The SDK does
#   NOT read the ~/.config/anthropic OAuth profile at the pinned version (0.68) —
#   a zero-arg client fails even with a valid, active login — so that script
#   exports the CLI session into ANTHROPIC_AUTH_TOKEN, which the SDK does accept.
#   Leaving this line blank is harmless either way.
ANTHROPIC_API_KEY=

# Model for insights (drives the MCP connector tool use — keep a capable tier).
# Bump to claude-opus-5 if insight quality matters more than speed/cost.
CLAUDE_MODEL=claude-sonnet-5

# Model for the mechanical hot paths: the rolling summary and slide extraction.
# Defaults to Haiku 4.5 (~3x cheaper than Sonnet: $1/$5 vs $3/$15 per MTok) —
# these are routine condensation tasks where the cheap tier holds up. Set to
# claude-sonnet-5 to trade cost for polish.
SUMMARY_MODEL=claude-haiku-4-5

# Token guard — cap how much text is sent to Claude per summary/insight call so
# cost stays bounded on long meetings (~4 chars ≈ 1 token). The most recent
# portion is kept; the summary also folds in its previous version, so it stays
# cumulative even when older lines are trimmed. Raise for more context per call.
TRANSCRIPT_MAX_CHARS=24000
CONTEXT_MAX_CHARS=4000

# ─── Transcription ───────────────────────────────────────────────────────
# Which transcription provider to use: "whisper" (local, default) or "deepgram".
TRANSCRIPTION_PROVIDER=whisper

# Local Whisper profile: "capable" (distil-large-v3, ~1s chunks, near-real-time)
# or "modest" (base/small, longer chunks, a few seconds of lag). Both are free
# and fully local. Also selectable at runtime from the UI.
WHISPER_PROFILE=modest

# Port the Python faster-whisper sidecar listens on (local WebSocket).
WHISPER_SIDECAR_PORT=8765

# Optional: only needed if TRANSCRIPTION_PROVIDER=deepgram.
DEEPGRAM_API_KEY=

# ─── Connections (MCP connectors for grounded insights) ──────────────────
# Each service is optional. A connector is enabled as soon as its *_MCP_URL is
# set; the *_MCP_TOKEN is optional (some hosted MCP servers embed auth in the URL
# itself — e.g. Zapier — so leave the token blank there). Leave a URL blank and
# that connector is skipped gracefully; the app still runs with whatever subset
# you configure (transcript + summary need none of these).
NOTION_MCP_URL=
NOTION_MCP_TOKEN=

SLACK_MCP_URL=
SLACK_MCP_TOKEN=

GDRIVE_MCP_URL=
GDRIVE_MCP_TOKEN=

# Zapier is the fan-out for Gmail + Telegram (and 9000+ other apps).
# Generate an MCP server URL at https://mcp.zapier.com and enable the actions you
# want (Gmail: Send Email, Telegram: Send Message, ...). The URL carries its own
# auth, so ZAPIER_MCP_TOKEN can stay blank.
ZAPIER_MCP_URL=
ZAPIER_MCP_TOKEN=

# ─── Signal (optional, unofficial local bridge) ──────────────────────────
# Share to Signal via signal-cli linked to your phone (unofficial; may break on
# Signal updates; uses a linked-device slot). Setup:
#   1. Install signal-cli:  https://github.com/AsamK/signal-cli
#   2. Link it:             signal-cli link -n "neat-meet"   (scan QR on phone)
#   3. Run the daemon:      signal-cli daemon --http 127.0.0.1:8686
# Then point at its JSON-RPC endpoint. Everything stays on your machine.
SIGNAL_CLI_URL=
# Only needed if the daemon hosts multiple accounts (E.164, e.g. +15551234567).
SIGNAL_ACCOUNT=

# ─── Message archive (Signal + WhatsApp ingestion, optional) ─────────────
# Archive your Signal/WhatsApp messages + media locally for agent memory.
# Full setup guide: docs/MESSAGES.md. Everything is stored on THIS machine
# under MESSAGES_DIR (gitignored); nothing is sent anywhere by ingesting.
MESSAGES_DIR=./data/messages

# Signal receiving — opt-in, separate from sending. Uses the same signal-cli
# daemon as SIGNAL_CLI_URL above; set SIGNAL_INGEST=1 to stream incoming (and
# your own phone-sent) messages into the archive.
SIGNAL_INGEST=
# Where signal-cli writes attachment files (default ~/.local/share/signal-cli/attachments).
SIGNAL_ATTACHMENTS_DIR=

# WhatsApp via the OFFICIAL Business Cloud API webhook (business number only).
# Set the verify token you configure in your Meta app; the webhook URL is
# <your host>/api/messages/whatsapp. ACCESS_TOKEN enables media download;
# APP_SECRET (recommended) enforces webhook signature checks.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# Generic bridge drop-off (POST /api/messages) for personal-account bridges you
# run yourself (Baileys, whatsmeow, mautrix — see docs/MESSAGES.md for the ToS
# caveats). Disabled until a token is set; requests must send x-bridge-token.
MESSAGES_BRIDGE_TOKEN=

# ─── Server ──────────────────────────────────────────────────────────────
PORT=3000
